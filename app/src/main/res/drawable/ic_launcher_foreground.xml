<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground — the wisp glyph with bright star-shaped eyes.

  Pure vector, 1024-unit viewport. The art is 729x768 (wider than the
  bare glyph, since the eye accents remain within the silhouette), placed by the inner
  group's translate so its centre lands on the canvas centre.

  The radial gradient is approximated as a circular one — the source SVG
  used an elliptical / rotated gradient (gradientTransform matrix) which
  AAPT vector drawables don't support, but the visual difference at
  launcher-icon sizes is negligible.

  The source SVG clipped the eyes to a rect; measured against the path
  bounds that clip is a no-op, so it is dropped here.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!--
      Group transform shrinks the mark inside the 108dp foreground canvas
      so the launcher's mask (circle / squircle / rounded square) doesn't
      crop it. Kept at the same 0.65 as the bare glyph: measured, the
      shades reach 563 of the 626-unit safe-zone diameter, so the extra
      width needs no rescale.
    -->
    <group
        android:scaleX="0.65"
        android:scaleY="0.65"
        android:pivotX="512"
        android:pivotY="512">
        <group
            android:translateX="146.484"
            android:translateY="126.976">
