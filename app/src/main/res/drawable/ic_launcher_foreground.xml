                <aapt:attr name="android:fillColor">
                    <gradient
                        android:type="radial"
                        android:centerX="333.608"
                        android:centerY="245.446"
                        android:gradientRadius="530">
                        <item android:offset="0" android:color="#FFBA60"/>
                        <item android:offset="0.961823" android:color="#E97941"/>
                    </gradient>
                </aapt:attr>
            </path>
            <path android:fillColor="#FFFFD85A" android:strokeColor="#FF7B351D" android:strokeWidth="8" android:strokeLineJoin="round" android:pathData="M210.0,377.0 L 222.3,406.0 L 253.7,408.8 L 230.0,429.5 L 237.0,460.2 L 210.0,444.0 L 183.0,460.2 L 190.0,429.5 L 166.3,408.8 L 197.7,406.0 Z"/>
            <path android:fillColor="#FFFFD85A" android:strokeColor="#FF7B351D" android:strokeWidth="8" android:strokeLineJoin="round" android:pathData="M408.0,377.0 L 420.3,406.0 L 451.7,408.8 L 428.0,429.5 L 435.0,460.2 L 408.0,444.0 L 381.0,460.2 L 388.0,429.5 L 364.3,408.8 L 395.7,406.0 Z"/>
            
